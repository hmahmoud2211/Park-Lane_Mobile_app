{
  "expo": {
    "name": "Parklane",
    "slug": "parklane",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Parklane talks to smart devices and your home hub on your local network while you set them up and control them.",
        "NSLocationWhenInUseUsageDescription": "Parklane reads the name of the Wi-Fi network you are on to check that you joined a device’s setup network. iOS shares network names only with apps allowed to use location.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.parklane.app"
    },
    "android": {
      "package": "com.parklane.app",
      "adaptiveIcon": {
        "backgroundColor": "#071B44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Parklane uses the microphone so you can talk to the Parklane Assistant."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Parklane uses the camera so the assistant can see what you show it, and so security staff can scan visitor parking passes.",
          "microphonePermission": "Parklane uses the microphone so you can talk to the Parklane Assistant.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-sharing",
      "react-native-wifi-reborn",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "backgroundColor": "#071B44",
    "extra": {
      "eas": {
        "projectId": "a8dcc67f-8647-4973-9c38-a0f522e87a4a"
      }
    },
    "owner": "hazemmahm03",
    "scheme": "parklane"
  }
}
