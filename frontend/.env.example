# Copy to .env.local (git ignores it) for development. EAS builds set these per profile in
# eas.json. Every EXPO_PUBLIC_* value is built into the app, so never put a secret here.
# src/config/env.ts reads them all.

# The EMS device backend (../backend). Empty: the smart-home sign-in says it is not configured.
# On a phone, use this computer's network address, e.g. http://192.168.1.50:8787.
EXPO_PUBLIC_DEVICE_BACKEND_URL=http://localhost:8787

# The Parklane Assistant backend. Leave unset for the hosted demo; e.g. http://192.168.1.20:8001
# for one running on the LAN (the WebSocket address is derived from it).
# EXPO_PUBLIC_ASSISTANT_URL=

# Health Passport: mock (sample data inside the app) or http (the backend). Unset: the mock in
# development and http in release builds, so sample records never reach residents by accident.
# EXPO_PUBLIC_HEALTH_API=mock
# Health Passport's backend. Unset: the EMS backend above.
# EXPO_PUBLIC_HEALTH_API_URL=

# The parking demo's tools (Demo controls, Security console). On unless 0, false or off.
# EXPO_PUBLIC_DEMO_TOOLS=1

# Testing aid for scripts/visual-regression.mjs: every screen gets a visual/<Route> web address.
# EXPO_PUBLIC_VISUAL_ROUTES=1
