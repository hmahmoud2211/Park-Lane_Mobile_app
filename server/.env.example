# Copy to server/.env (git ignores it) and fill in.

# Where the backend listens. 0.0.0.0 makes it reachable from phones and the hub on the LAN.
HOST=0.0.0.0
PORT=8787

# The address the CUBE hub uses to send commands for SONOFF plugs to this backend.
# Must be reachable from the hub (192.168.1.119), so use this machine's LAN IP, not localhost.
PUBLIC_URL=http://192.168.1.50:8787

# Optional. When set, the app must send `Authorization: Bearer <key>`
# (EXPO_PUBLIC_DEVICE_BACKEND_KEY in the app's .env.local).
BACKEND_API_KEY=

# The CUBE hub. Give its web console password (the backend approves its own
# Open API token with it) or an already-issued Open API token.
CUBE_URL=http://192.168.1.119
CUBE_PASSWORD=
CUBE_TOKEN=

# Optional: the IPv4 address of the network interface to listen for mDNS on,
# when this machine has several (e.g. Wi-Fi and Ethernet).
MDNS_INTERFACE=

# Optional: which origins may call the API from a browser (the Expo web build).
CORS_ORIGIN=*

# Where registered plugs (and their keys) are kept. Created with owner-only permissions.
DATA_DIR=./data

# ---- EMS accounts, devices and Alexa (see ../ALEXA_INTEGRATION.md) ----------------

# The HTTPS address phones, browsers and Amazon reach this backend at. Account linking is off until set.
EMS_PUBLIC_URL=https://api-iot.example.com

# 32 random bytes, base64 (openssl rand -base64 32). Seals stored Amazon tokens and plug keys.
# When empty, one is generated into DATA_DIR/ems.key; set it explicitly in production.
EMS_ENCRYPTION_KEY=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For (for per-client rate limits).
TRUST_PROXY=

# The skill (Alexa developer console > your skill > copy Skill ID). Stage: development until certified, then live.
ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
ALEXA_SKILL_STAGE=development

# Console > Build > Account Linking > "Allow users to link their account to your skill from within your application":
# the "Alexa Client ID" and "Alexa Client Secret" it shows (Login with Amazon, used by app-initiated linking).
ALEXA_LWA_CLIENT_ID=
ALEXA_LWA_CLIENT_SECRET=

# The "Your Client ID" / "Your Secret" you enter in the same Account Linking page. Alexa sends them to /oauth/token.
# Generate the secret with: openssl rand -base64 32
ALEXA_OAUTH_CLIENT_ID=ems-alexa
ALEXA_OAUTH_CLIENT_SECRET=

# The "Alexa Redirect URLs" listed at the bottom of the Account Linking page, comma separated.
ALEXA_REDIRECT_URIS=https://layla.amazon.com/api/skill/link/XXXXXXXX,https://pitangui.amazon.com/api/skill/link/XXXXXXXX,https://alexa.amazon.co.jp/api/skill/link/XXXXXXXX

# Where the browser returns after linking: the app's scheme (app.json "scheme").
APP_RETURN_URL=parklane://alexa-link

# DEVELOPMENT ONLY: lets the skill call the voice API before account linking works, acting as this EMS user.
# Ignored when NODE_ENV=production. Leave both empty once account linking is set up.
DEV_VOICE_TOKEN=
DEV_VOICE_USER_EMAIL=

# ---- SONOFF plugs that connect here instead of eWeLink's cloud (src/sonoff/cloud.ts) ----
# Off while SONOFF_CLOUD_PORT is empty. The app gives plugs SONOFF_CLOUD_HOST and the port while
# pairing; the plug then keeps a connection here from any network. The host must be DNS only (not
# behind Cloudflare's proxy) and the port open in the firewall. Any certificate works: plugs don't check it.
SONOFF_CLOUD_PORT=
SONOFF_CLOUD_HOST=
SONOFF_CLOUD_CERT=
SONOFF_CLOUD_KEY=

# ---- LG appliances through rethink (../docker/rethink) ----
# The MQTT broker rethink publishes to. Leave empty to turn LG support off.
RETHINK_MQTT_URL=mqtt://localhost:1883
# Optional: rethink's public addresses, the `advertise` values of https_port and mqtts_port in its
# config.json, on a DNS-only name (not behind Cloudflare's proxy). The app gives them to a ThinQ2 AC
# while pairing, so the AC reaches rethink from any network instead of needing a DNS override on the
# AC's network. Set both or neither. ThinQ1 models always need the DNS override.
RETHINK_API_SERVER=
RETHINK_MQTT_SERVER=
