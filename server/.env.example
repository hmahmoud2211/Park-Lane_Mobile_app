# Copy to server/.env (git ignores it) and fill in.

# Where the backend listens.
HOST=0.0.0.0
PORT=8787

# Guards /api/health and the admin API (units, residents, hubs). The admin API is off until it is set.
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=

# Optional: which origins may call the API from a browser (the Expo web build).
CORS_ORIGIN=*

# Where the EMS database lives. Created with owner-only permissions.
DATA_DIR=./data

# 32 random bytes, base64 (openssl rand -base64 32). Seals hub tokens and other stored secrets.
# When empty, one is generated into DATA_DIR/ems.key; set it explicitly in production.
EMS_ENCRYPTION_KEY=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For (for per-client rate limits).
TRUST_PROXY=

# ---- Home Assistant per unit (see README, "On the server") -------------------------------

# The image every unit runs. Pin a release in production.
HA_IMAGE=ghcr.io/home-assistant/home-assistant:stable

# The Docker Engine socket. Defaults to /var/run/docker.sock (//./pipe/docker_engine on Windows).
DOCKER_SOCKET=

# The private Docker network the containers and this backend share.
HA_NETWORK=parklane-ha

# Where each unit's /config is written (default DATA_DIR/ha), and the same folder as Docker
# sees it when this backend runs in a container.
HA_CONFIG_ROOT=
HA_CONFIG_HOST_ROOT=

# Memory cap per unit, in MB.
HA_MEMORY_MB=512

# The units' time zone, e.g. Asia/Riyadh.
HA_TIME_ZONE=UTC

# DEVELOPMENT ONLY: publish each container on a random 127.0.0.1 port, for a backend that is
# not on the Docker network.
HA_PUBLISH_LOCAL_PORTS=

# Where a separately run hub (POST /api/admin/hubs) may live, as CIDRs, e.g. a WireGuard range.
HA_ALLOWED_NETWORKS=100.64.0.0/10

# Optional: the company's OAuth apps for cloud brands that sign in through a browser, added to
# every new unit. JSON: {"smartthings": {"clientId": "…", "clientSecret": "…"}}
HA_OAUTH_CREDENTIALS=

# How long a command waits for the device to report its new state, in ms.
HA_COMMAND_TIMEOUT_MS=8000
