# Copy to server/.env (git ignores it) and fill in.

# Where the backend listens. 0.0.0.0 makes it reachable from phones and the hub on the LAN.
HOST=0.0.0.0
PORT=8787

# The address the CUBE hub uses to send commands for SONOFF plugs to this backend.
# Must be reachable from the hub (192.168.1.119), so use this machine's LAN IP, not localhost.
PUBLIC_URL=http://192.168.1.50:8787

# Optional. When set, the app must send `Authorization: Bearer <key>`
# (EXPO_PUBLIC_DEVICE_BACKEND_KEY in the app's .env.local).
BACKEND_API_KEY=

# The CUBE hub. Give its web console password (the backend approves its own
# Open API token with it) or an already-issued Open API token.
CUBE_URL=http://192.168.1.119
CUBE_PASSWORD=
CUBE_TOKEN=

# Optional: the IPv4 address of the network interface to listen for mDNS on,
# when this machine has several (e.g. Wi-Fi and Ethernet).
MDNS_INTERFACE=

# Optional: which origins may call the API from a browser (the Expo web build).
CORS_ORIGIN=*

# Where registered plugs (and their keys) are kept. Created with owner-only permissions.
DATA_DIR=./data
