# Copy to backend/.env (git ignores it) and fill in.

# Where the backend listens.
HOST=0.0.0.0
PORT=8787

# Guards /api/health and the admin API (units, residents, hubs). The admin API is off until it is set.
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=

# The HTTPS address phones and browsers reach this backend at, e.g. https://api-iot-2.ems-iot.com.
# Brands that sign in through a browser (SmartThings, Nest, …) return to
# PUBLIC_URL/api/accounts/oauth/auth/external/callback: register that address with each brand.
PUBLIC_URL=

# Where the browser goes after a brand sign-in: the app's scheme (app.json "scheme").
APP_RETURN_URL=parklane://accounts

# Optional: which origins may call the API from a browser (the Expo web build).
CORS_ORIGIN=*

# Where the EMS database lives. Created with owner-only permissions.
DATA_DIR=./data

# 32 random bytes, base64 (openssl rand -base64 32). Seals hub tokens and other stored secrets.
# When empty, one is generated into DATA_DIR/ems.key; set it explicitly in production.
EMS_ENCRYPTION_KEY=

# The ready-made sign-in the backend creates on starting (ems / 5002 when these are left out).
# The password is short and known: never put a real home or real medical records in this account.
# Empty values turn it off. Changing them later does not change an account that already exists.
# EMS_DEFAULT_USERNAME=ems
# EMS_DEFAULT_PASSWORD=5002

# The first admin for the dashboard at /admin, made on starting while no admin exists. Leave the password empty to
# have one generated and printed once in the backend's log; either way it must be changed at the first sign-in.
# EMS_ADMIN_USERNAME=admin
# EMS_ADMIN_PASSWORD=

# Set to 1 behind Cloudflare and/or our own reverse proxy, for per-client rate limits: the caller is then
# Cloudflare's CF-Connecting-IP, or else the right-most X-Forwarded-For entry (the one our proxy added). Leave empty
# when the backend is reached directly. The origin should be reachable only through those proxies.
TRUST_PROXY=

# ---- The backend's own container (compose.yaml, ./scripts/dev.sh server) -------------------

# The host folder holding DATA_DIR, HA_CONFIG_ROOT and HA_CUSTOM_COMPONENTS, mounted into the
# container at the same path. Not used when the backend runs outside Docker.
PARKLANE_DATA=

# The group that owns the Docker socket: stat -c %g /var/run/docker.sock (dev.sh finds it itself).
DOCKER_GID=

# The backend image's name, without a tag. `dev.sh push` pushes it, `dev.sh server --pull <commit>` pulls it.
# BACKEND_IMAGE=hmahmoud2211/parklane-backend

# ---- CUBE gateway per unit (ems/gatewayProvisioner.ts) ------------------------------------

# Set this and every apartment created in the dashboard gets its CUBE gateway container on this server, linked to it:
# CUBE_RELAY_ENROLL_TOKEN from the relay's relay.env. Also needs PUBLIC_URL (or GATEWAY_EMS_URL) and the Docker socket.
GATEWAY_RELAY_ENROLL_TOKEN=
# GATEWAY_RELAY_URL=https://cube-relay.ems-iot.com
# GATEWAY_IMAGE=hmahmoud2211/cube-os-gateway:latest
# The local ports the gateways listen on (127.0.0.1 only), one each. Ports new-apartment.sh gateways use are skipped.
# GATEWAY_PORTS=18700-18999
# Where the gateways reach this backend, when not PUBLIC_URL.
# GATEWAY_EMS_URL=
# The device broker and the shared ReThink on this host, as new-apartment.sh uses them (empty value: left out).
# GATEWAY_CLOUD_MQTT_URL=mqtt://127.0.0.1:1886
# GATEWAY_RETHINK_MQTT_URL=mqtt://127.0.0.1:1885
# GATEWAY_RETHINK_API_SERVER=https://lg.ems-iot.com:4443
# GATEWAY_RETHINK_MQTT_SERVER=ssl://lg.ems-iot.com:8884

# ---- CUBE relay, started with the backend (compose.yaml) -----------------------------------

# Uncomment and `docker compose up` (and dev.sh server) start the relay too, as container cube-relay.
# COMPOSE_PROFILES=relay
# The relay's own settings (CUBE_RELAY_ENROLL_TOKEN, the broker's admin login), outside the repo, mode 0600.
# RELAY_ENV_FILE=/home/ems-server/EMS/cube-relay/relay.env
# The gateway image in relay mode. Pin a version or a digest (…@sha256:…): a moving tag such as :latest
# also moves when an apartment's gateway pulls it, and the relay then follows at its next start.
# RELAY_IMAGE=hmahmoud2211/cube-os-gateway:latest
# The device broker's CA certificate, when the relay manages the broker (setup-broker.sh). Never the key.
# RELAY_CA_FILE=/home/ems-server/EMS/cube-mqtt/certs/ca.crt

# ---- Home Assistant per unit (see README, "On the server") -------------------------------

# The image every unit runs. Pin a release in production.
HA_IMAGE=ghcr.io/home-assistant/home-assistant:stable

# The Docker Engine socket. Defaults to /var/run/docker.sock (//./pipe/docker_engine on Windows).
DOCKER_SOCKET=

# The private Docker network the containers and this backend share.
HA_NETWORK=parklane-ha

# Where each unit's /config is written (default DATA_DIR/ha), and the same folder as Docker
# sees it when this backend runs in a container.
HA_CONFIG_ROOT=
HA_CONFIG_HOST_ROOT=

# Optional: a folder of community integrations copied into every new unit's custom_components,
# e.g. ./custom_components holding sonoff/ from https://github.com/AlexxIT/SonoffLAN (SONOFF / eWeLink).
HA_CUSTOM_COMPONENTS=

# Memory cap per unit, in MB.
HA_MEMORY_MB=512

# The units' time zone, e.g. Asia/Riyadh.
HA_TIME_ZONE=UTC

# DEVELOPMENT ONLY: publish each container on a random 127.0.0.1 port, for a backend that is
# not on the Docker network.
HA_PUBLISH_LOCAL_PORTS=

# Where a separately run hub (POST /api/admin/hubs) may live, as CIDRs, e.g. a WireGuard range.
HA_ALLOWED_NETWORKS=100.64.0.0/10

# Optional: the company's OAuth apps for cloud brands that sign in through a browser, added to
# every new unit. JSON: {"smartthings": {"clientId": "…", "clientSecret": "…"}}
HA_OAUTH_CREDENTIALS=

# How long a command waits for the device to report its new state, in ms.
HA_COMMAND_TIMEOUT_MS=8000

# ---- The compound clinic and Health Passport (see ../docs/CLINIC.md) ----------------------

# Doctors' hours are written in this zone; appointments are stored in UTC.
CLINIC_TIMEZONE=Africa/Cairo
# How far ahead residents can book, and how soon before a slot booking closes (minutes).
CLINIC_BOOKING_HORIZON_DAYS=30
CLINIC_BOOKING_LEAD_MINUTES=30
# Testing only: 1 lets residents book any future minute on any day, ignoring the doctor's hours.
# Ignored when NODE_ENV=production.
CLINIC_ANY_TIME_BOOKING=
# Arriving later than this after the slot starts queues the patient by arrival time.
CLINIC_LATE_GRACE_MINUTES=10
# Upcoming appointments one resident may hold across their family.
CLINIC_MAX_UPCOMING=6
# Doctor and front-desk sessions (the residents' app keeps 30 days).
CLINIC_STAFF_SESSION_HOURS=12
# Transcripts and AI drafts are deleted this many days after a consultation is finalized.
CLINIC_TRANSCRIPT_RETENTION_DAYS=30

# AI: Health Passport (reading documents, spoken summaries) and the clinic (history
# summaries, consultation notes). Off until a key is set; only this backend holds it.
# AI_PROVIDER: gemini or anthropic. Left empty: Gemini when GEMINI_API_KEY is set.
AI_PROVIDER=
# Use a paid (billing-enabled) Gemini API project for patient data.
GEMINI_API_KEY=
# gemini-3.8-flash: the strongest Flash model, reads photos and PDFs. gemini-4-argon: the flagship, slower.
GEMINI_MODEL=gemini-3.8-flash
# Reading photographed and scanned documents; defaults to GEMINI_MODEL.
GEMINI_DOCUMENT_MODEL=gemini-3.8-flash
# low, medium or high.
GEMINI_THINKING_LEVEL=medium
# Claude instead (AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# ElevenLabs, for reading summaries aloud and transcribing consultations. Off until the key is set.
ELEVENLABS_API_KEY=
# eleven_v4 reads Arabic and English (up to 10,000 characters a request).
ELEVENLABS_TTS_MODEL=eleven_v4
# A voice from your ElevenLabs voice library. Set an Arabic voice for Arabic summaries.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_STT_MODEL=scribe_v2
# 1 sends enable_logging=false (zero retention at ElevenLabs). Enterprise plans only.
ELEVENLABS_ZERO_RETENTION=
# 0 stops sending the patient's documented medicine and condition names as transcription key terms.
ELEVENLABS_STT_KEYTERMS=1

# The public privacy policy (/privacy) and account deletion page (/account/delete), which the App Store
# and Google Play listings link to. Until the operator and contact are set, /privacy says it is a draft.
# LEGAL_OPERATOR_NAME=
# LEGAL_CONTACT_EMAIL=
# PRIVACY_POLICY_DATE=2026-11-10
