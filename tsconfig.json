{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // The device backend is a Node service with its own tsconfig (server/tsconfig.json),
  // and IOT/ is the Home Assistant platform, a separate Python project.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "server",
    "IOT"
  ]
}
