{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_DEVICE_BACKEND_URL": "https://api-iot-2.ems-iot.com",
        "EXPO_PUBLIC_ASSISTANT_URL": "https://attal_voice_2.ems-iot.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEVICE_BACKEND_URL": "https://api-iot-2.ems-iot.com",
        "EXPO_PUBLIC_ASSISTANT_URL": "https://attal_voice_2.ems-iot.com"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEVICE_BACKEND_URL": "https://api-iot-2.ems-iot.com",
        "EXPO_PUBLIC_ASSISTANT_URL": "https://attal_voice_2.ems-iot.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
